# Copy this file to .env and adjust values for your machine.

DJANGO_SECRET_KEY=this_must_be_a_random_long_string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres container credentials (db service in docker-compose.yml)
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence

# Consumed by Django (core/settings.py). Host "db" / "redis" are the compose service names.
DATABASE_URL=postgres://transcendence:transcendence@db:5432/transcendence
# Deployed, this is a managed Redis and the URL is a secret: it goes in Render's
# environment, never in a file. `rediss://` (TLS) works as-is — channels_redis
# hands the URL to redis-py, which reads the scheme.
REDIS_URL=redis://redis:6379/0

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FORTYTWO_OAUTH_CLIENT_ID=
FORTYTWO_OAUTH_CLIENT_SECRET=

DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost,https://localhost

FRONTEND_URL=https://localhost

DJANGO_EMAIL_USE_SMTP=False
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=no-reply@localhost

# --- Deployment ------------------------------------------------------------

# Where uploaded files used to be written. Nothing writes here any more —
# avatars and the pictures downloaded from Google and 42 are rows in the
# database, because a container's disk does not survive a deploy
# (docs/adr/0005-uploaded-files-live-in-the-database.md).
#
# It is still read by `manage.py import_media_to_db`, which copies files saved
# before the move into the database. Leave it empty unless yours are somewhere
# other than backend/media.
DJANGO_MEDIA_ROOT=

# The built single-page app, served by this process at the site root. Leave it
# empty everywhere except the deployed image, which sets it to /srv/frontend:
# locally Vite serves the app (`make up`) or nginx does (prod compose), and a
# stale dist/ served from here instead of the dev server is a confusing hour.
# Why the deployment serves both from one process:
# docs/adr/0004-one-origin-in-production.md
DJANGO_FRONTEND_DIST=

# How many people may watch one room. A system limit, not a room setting.
DJANGO_GAME_MAX_SPECTATORS=6

# How long a disconnected player's seat is held before the lobby hands off the
# host or closes the room — long enough to survive a page refresh.
DJANGO_GAME_DISCONNECT_GRACE_SECONDS=10

# Background work runs on threads, not a queue (game_api/background.py). Off
# makes every task synchronous.
DJANGO_RUN_TASKS_IN_BACKGROUND=True
